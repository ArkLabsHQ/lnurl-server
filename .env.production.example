LNURL_SERVER_IMAGE=ghcr.io/arklabshq/lnurl-server@sha256:replace-with-published-digest
PORT=3000
BASE_URL=https://pay.example.com
DB_PATH=/data/lnurl.sqlite
BOOTSTRAP_DOMAIN=pay.example.com
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters

ADMIN_PORT=3001
ADMIN_BIND=0.0.0.0
TRUST_PROXY=1

SOLVER_REGISTRY_URLS=https://registry.example.com/mutinynet.json
SOLVER_CARDS_FILE=/run/config/solver-cards.json
COVCLAIMD_URL=https://covclaimd.example.com
ARK_SERVER_URL=https://mutinynet.arkade.sh

MAX_SESSIONS=5000
MAX_SESSIONS_PER_IP=50
MAX_CONCURRENT_OFFLINE_QUOTES=20
SHUTDOWN_TIMEOUT_MS=15000
