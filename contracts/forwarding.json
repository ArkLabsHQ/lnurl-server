  "source": {
    "entry": "forwarding.ark",
    "files": {
      "forwarding.ark": "pragma arkade ^0.1.0;\n\ncontract Forwarding(\n  pubkey destinationKey,\n  pubkey userKey,\n  bytes20 preimageHash,\n  int recoverySequence\n) {\n  function sweep() {\n    int inputIndex = this.activeInputIndex;\n    require(this.tunnel(inputIndex, { scriptPubKey: false, value: false, assets: true }));\n    require(tx.outputs[inputIndex].witnessVersion == 1);\n    require(tx.outputs[inputIndex].scriptPubKey == destinationKey);\n    require(tx.outputs[inputIndex].value >= tx.inputs[inputIndex].value);\n  }\n\n  function sweep(bytes preimage, signature serverSig, signature emulatorSig) tapscript {\n    require(hash160(preimage) == preimageHash);\n    require(checkMultisig([server, emulator], [serverSig, emulatorSig]));\n  }\n\n  function collaborative(signature userSig, signature serverSig) tapscript {\n    require(checkMultisig([userKey, server], [userSig, serverSig]));\n  }\n\n  function recovery(signature userSig) tapscript {\n    require(older(recoverySequence));\n    require(checkSig(userSig, userKey));\n  }\n\n  function renew() {\n    require(tx.intent.field(\"type\") == \"register\");\n    require(tx.intent.field(\"onchain_output_indexes\") == \"[]\");\n    require(!tx.intent.has(\"cosigners_public_keys.1\"));\n    require(this.tunnel(this.activeInputIndex - 1));\n  }\n}\n"
    }
  },
