{
  "name": "@arkade-os/lnurl-client",
  "version": "0.4.4",
  "description": "Full-duplex client for the lnurl-server protocol (payer and receiver)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./arkade": {
      "types": "./dist/arkade.d.ts",
      "import": "./dist/arkade.js",
      "default": "./dist/arkade.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@scure/base": "^2.0.0"
  },
  "peerDependencies": {
    "@arkade-os/sdk": ">=0.4.0 || >=0.5.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@arkade-os/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
