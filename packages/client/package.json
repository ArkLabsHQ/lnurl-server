{
  "name": "@arkade-os/lnurl-client",
  "version": "0.9.0",
  "description": "Full-duplex client for the lnurl-server protocol (payer and receiver)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArkLabsHQ/lnurl-server.git",
    "directory": "packages/client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./arkade": {
      "types": "./dist/arkade.d.ts",
      "import": "./dist/arkade.js",
      "default": "./dist/arkade.js"
    },
    "./hd": {
      "types": "./dist/hd.d.ts",
      "import": "./dist/hd.js",
      "default": "./dist/hd.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@scure/bip32": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "^2.0.0"
  },
  "peerDependencies": {
    "@arkade-os/sdk": ">=0.5.0-rc.0"
  },
  "peerDependenciesMeta": {
    "@arkade-os/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
