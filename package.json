{
  "name": "@arkade-os/lnurl",
  "version": "0.3.4",
  "description": "LNURL service for amountless Lightning receives via Arkade swaps",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:client",
    "build:server": "tsup && vite build && node scripts/smoke-dist.mjs",
    "build:client": "tsup --config packages/client/tsup.config.ts",
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite tsx watch src/cli.ts",
    "start": "node --experimental-sqlite --experimental-eventsource dist/cli.js",
    "test": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:e2e": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run --config vitest.e2e.config.ts",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-sqlite vitest",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.ui.json && tsc -p packages/client/tsconfig.json && tsc -p packages/demo-wallet/tsconfig.json && tsc -p packages/demo-wallet/tsconfig.e2e.json",
    "test:browser": "pnpm --filter @arkade-os/lnurl-demo-wallet test:e2e",
    "test:browser:local": "cross-env NODE_OPTIONS=\"--experimental-sqlite --experimental-eventsource\" pnpm --filter @arkade-os/lnurl-demo-wallet test:e2e:local",
    "test:bench:local": "cross-env NODE_OPTIONS=\"--experimental-sqlite --experimental-eventsource\" pnpm --filter @arkade-os/lnurl-demo-wallet test:e2e:bench"
  },
  "dependencies": {
    "@arkade-os/sdk": "0.4.74",
    "@arkade-os/solver-discovery": "0.2.7",
    "@arkade-os/swap": "0.0.20",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@noble/ciphers": "2.1.1",
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@scure/base": "^2.4.0",
    "@scure/btc-signer": "2.0.1",
    "cors": "^2.8.6",
    "express": "5.2.1",
    "nostr-tools": "^2.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@scure/bip39": "^2.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "form-data": "^4.0.6",
      "@arkade-os/sdk": "0.4.74"
    }
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.25.0 <11"
  }
}
