{
  "name": "@arkade-os/lnurl",
  "version": "0.1.0",
  "description": "LNURL service for amountless Lightning receives via Arkade swaps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/admin-server.ts --format esm --dts && vite build",
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite tsx watch src/cli.ts",
    "start": "node --experimental-sqlite dist/cli.js",
    "test": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-sqlite vitest",
    "type-check": "tsc --noEmit && tsc -p tsconfig.ui.json"
  },
  "dependencies": {
    "@scure/base": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "supertest": "^7.2.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.25.0 <11"
  }
}
